# Кінці рядків. Без цього файлу git на Windows перетворює їх сам, і зразки
# відповідей сайтів приїжджають на іншу машину іншими байтами, ніж поїхали.

* text=auto

# Зразки для тестів — байт у байт, жодних перетворень. Тести розбирають їх
# як справжню відповідь сайту; змінений кінець рядка це вже інша відповідь.
tests/samples/** -text

# Батники Windows мусять лишатися CRLF, інакше cmd спотикається на першому ж
# рядку. «Відкрити вакансії.bat» уже був переписаний на CRLF саме через це.
*.bat text eol=crlf
